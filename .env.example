# ==============================================================================
# BharatScheme AI — Environment Configuration Example
# ==============================================================================
# Copy this file to .env and customize the values for your local environment.
# All values are optional. The system functions fully offline with defaults.

# ------------------------------------------------------------------------------
# Database Settings
# ------------------------------------------------------------------------------
# Default: SQLite database stored in backend/bharatscheme.db
# For PostgreSQL: postgresql://username:password@localhost:5432/bharatscheme
DATABASE_URL=sqlite:///./bharatscheme.db

# ------------------------------------------------------------------------------
# LLM Providers (Optional - BharatScheme includes built-in offline RAG synthesizer)
# ------------------------------------------------------------------------------
# Gemini API Key (recommended for enhanced reasoning):
# GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (alternative LLM provider):
# OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# Server Settings
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
